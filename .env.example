APP_NAME=Media AI Platform API
APP_VERSION=2.0.0
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/v1

DATABASE_URL=postgresql+psycopg://mediaai:mediaai@postgres:5432/mediaai
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CACHE_TTL_SECONDS=300
ENABLE_METRICS=true
ENABLE_REDIS_CACHE=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
